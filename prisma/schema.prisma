generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String   @default("")
  email      String   @unique
  password   String
  avatarUrl  String?
  role       UserRole @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Cars {
  id                        String          @id @default(uuid())
  name                      String          
  brand                     String          @default("")
  model                     String          @default("")
  fipe                      Float           @default(0)
  year                      Int             @default(0)
  imageUrl                  String?
  description               String?
  created_at                DateTime        @default(now())
  updated_at                DateTime        @updatedAt
  videoUrl                  String?
  popular                   Boolean         @default(false)
  brandId                   String?
  brand_db                  Brands?         @relation(fields: [brandId], references: [id])
  features                  Features?
  specifications            Specifications?
  top_10                    TopCars?
  bodyworkId                String?
  bodywork                  BodyworkType?   @relation(fields: [bodyworkId], references: [id])
}

model BodyworkType {
  id    String  @id  @default(uuid())
  name  String?
  image String?

  cars  Cars[]
}

model TopCars {
  id    String @id @default(uuid())
  order Int?
  carId String @unique
  car   Cars   @relation(fields: [carId], references: [id])
}

model Specifications {
  id            String           @id @default(uuid())
  fuel          FuelType         @default(GASOLINE)
  engine        String           @default("")
  power         String           @default("")
  torque        String?
  consumption   String           @default("")
  transmission  TransmissionType @default(MANUAL)
  traction      String?
  seats         Int?
  doors         Int?
  trunkCapacity String?
  weight        String?
  maxSpeed      String?
  acceleration  String?
  carId         String           @unique
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  car           Cars             @relation(fields: [carId], references: [id])
}

model Features {
  id              String   @id @default(uuid())
  carId           String   @unique
  airBag          Boolean  @default(false)
  absBrakes       Boolean  @default(false)
  electricWindows Boolean  @default(false)
  airConditioning Boolean  @default(false)
  alarm           Boolean  @default(false)
  centralLocking  Boolean  @default(false)
  powerSteering   Boolean  @default(false)
  rearCamera      Boolean  @default(false)
  bluetooth       Boolean  @default(false)
  usbPort         Boolean  @default(false)
  gps             Boolean  @default(false)
  alloyWheels     Boolean  @default(false)
  fogLights       Boolean  @default(false)
  sunroof         Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  car             Cars     @relation(fields: [carId], references: [id])
}

model Brands {
  id                      String  @id @default(uuid())
  name                    String? @unique
  logo_img                String?

  cars                    Cars[]
}

enum UserRole {
  ADMIN
  USER
}

enum FuelType {
  GASOLINE
  ETHANOL
  DIESEL
  ELECTRIC
  HYBRID
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  SEMI_AUTOMATIC
}
